---
import { type Lang, useTranslations } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const rows = [1, 2, 3, 4].map((i) => ({
  id: t(`services.${i}.id` as Parameters<typeof t>[0]),
  title: t(`services.${i}.title` as Parameters<typeof t>[0]),
  note: t(`services.${i}.note` as Parameters<typeof t>[0]),
}));
---

{/* Leistungen: part-numbered rows; hovering draws CAD dimension lines */}
<section id="leistungen" class="surface-paper border-t border-line">
  <div class="mx-auto max-w-[1200px] px-6 py-20 md:py-28" data-reveal-scope>
    <p class="type-annot text-steel-deep" data-reveal>{t('services.kicker')}</p>
    <h2 class="type-display mt-4 max-w-[26ch] text-[clamp(1.9rem,3.6vw,3rem)]" data-reveal>
      {t('services.title')}
    </h2>

    <div class="mt-12 border-t border-line">
      {
        rows.map((row) => (
          <div class="dim-row grid grid-cols-1 gap-2 border-b border-line py-7 sm:grid-cols-12 sm:items-baseline sm:gap-6" data-reveal>
            <span class="dim-tick" aria-hidden="true">{row.id}</span>
            <span class="type-annot text-steel-deep sm:col-span-2">{row.id}</span>
            <h3 class="type-subhead text-2xl sm:col-span-4">{row.title}</h3>
            <p class="text-[0.95rem] leading-relaxed text-steel-deep sm:col-span-6">{row.note}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
