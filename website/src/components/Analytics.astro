---
/**
 * Cookieless analytics — three options, all off by default, so the site keeps
 * its "no third-party requests" property until someone flips a value in
 * src/config/site.ts. No consent banner is required for any of them: none
 * sets a cookie or stores personal data.
 *
 * - `plausibleDomain`: Plausible's script, one third-party request per page.
 * - `cfAnalyticsToken`: Cloudflare Web Analytics, the same shape.
 * - `statsEnabled` (D-063): our own beacon, Beacon.astro — one meta tag and
 *   src/scripts/beacon.ts, which reports to /api/hit on this origin. Rendered
 *   only when the flag is on: a `false` flag means the built pages carry no
 *   beacon script at all — zero requests, not merely zero third-party ones —
 *   and the meta is what the module checks before it registers anything.
 */
import { SITE } from '../config/site';
import Beacon from './Beacon.astro';
---

{
  SITE.plausibleDomain && (
    <script
      is:inline
      defer
      data-domain={SITE.plausibleDomain}
      src="https://plausible.io/js/script.outbound-links.js"
    />
  )
}

{
  SITE.cfAnalyticsToken && (
    <script
      is:inline
      defer
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon={`{"token": "${SITE.cfAnalyticsToken}"}`}
    />
  )
}

{SITE.statsEnabled && <Beacon />}
