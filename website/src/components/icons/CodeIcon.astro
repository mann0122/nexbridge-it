---
/**
 * Code brackets — part symbol for NB-04 Individualsoftware. itshover port
 * (D-043), CSS-only. On parent hover the brackets spread ±1.5px (upstream's ±3
 * clips the 24 box: the left bracket already reaches x=2) and ease back on leave.
 */
interface Props {
  size?: number;
  class?: string;
}
const { size = 20, class: className } = Astro.props;
---

<svg
  class:list={['icn-code', className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  aria-hidden="true"
>
  <path class="icn-code-r" d="m16 18 6-6-6-6"></path>
  <path class="icn-code-l" d="m8 6-6 6 6 6"></path>
</svg>

{/* Styles live in global.css (D-043 icon system section). */}
