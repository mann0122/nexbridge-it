---
import { type Lang, useTranslations } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const rows = [1, 2, 3].map((i) => ({
  pos: t(`problems.${i}.pos` as Parameters<typeof t>[0]),
  title: t(`problems.${i}.title` as Parameters<typeof t>[0]),
  note: t(`problems.${i}.note` as Parameters<typeof t>[0]),
}));
---

{/* Positionsliste as a literal DIN parts table — ruled columns, mono headers */}
<section class="surface-paper">
  <div class="mx-auto max-w-[1200px] px-6 py-20 md:py-28" data-reveal-scope>
    <p class="type-annot text-steel-deep" data-reveal>{t('problems.kicker')}</p>
    <h2 class="type-display mt-4 max-w-[24ch] text-[clamp(1.9rem,3.6vw,3rem)]" data-reveal>
      {t('problems.title')}
    </h2>

    <table class="mt-12 w-full border-collapse text-left">
      <thead>
        <tr class="border-y border-graphite">
          <th scope="col" class="type-annot w-[14%] py-2.5 pr-4 font-normal text-steel-deep">{t('problems.col.pos')}</th>
          <th scope="col" class="type-annot w-[40%] py-2.5 pr-4 font-normal text-steel-deep">{t('problems.col.title')}</th>
          <th scope="col" class="type-annot py-2.5 font-normal text-steel-deep">{t('problems.col.note')}</th>
        </tr>
      </thead>
      <tbody>
        {
          rows.map((row) => (
            <tr class="border-b border-line align-baseline" data-reveal>
              <td class="type-annot py-5 pr-4 text-steel-deep">{row.pos}</td>
              <td class="type-subhead py-5 pr-4 text-lg md:text-xl">{row.title}</td>
              <td class="py-5 text-[0.95rem] leading-relaxed text-steel-deep">{row.note}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</section>
