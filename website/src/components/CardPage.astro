---
/**
 * Digital business card (NB-VK) — the page behind the printed NFC/QR cards.
 * One component for DE (/karte/<slug>) and EN (/en/card/<slug>); the visitor
 * has just tapped a card with their phone, so 360px is the primary viewport.
 *
 * The concept (D-049): the page is a product photograph of the card that
 * was just tapped — one precision-machined signal-orange anodized plate on
 * a graphite void, complete from the first frame. The plate itself IS the
 * save action: the whole card is the vCard link, the house CTA grammar
 * scaled up to an object. It counts as the viewport's ONE signal element;
 * every line of ink on it is graphite (5.4:1 on mid-signal, better on the
 * soft stop). Below the object the stage stays quiet: contact rows,
 * second-rank actions, one annotation line.
 *
 * Motion: entrance rise-and-settle with a one-time sheen sweep; the page's
 * ONE idle loop is the 9s sheen drift (the flow pulse died with the old
 * schematic skin — reassignment logged in D-049). Pointer tilt on fine
 * pointers, horizontal drag tilt on touch, no gyroscope. The sheen's
 * parked state is the CSS default, so no-JS, ?snap and reduced-motion all
 * rest on the finished still-life by construction.
 *
 * noindex: cards are handouts, not landing pages. They are also excluded
 * from the sitemap (astro.config.mjs) and carry no hreflang alternates —
 * the DE↔EN toggle in CardFooter still maps the twin paths.
 */
import Layout from '../layouts/Layout.astro';
import CardHeader from './CardHeader.astro';
import CardFooter from './CardFooter.astro';
import CtaArrow from './icons/CtaArrow.astro';
import PhoneIcon from './icons/PhoneIcon.astro';
import MailIcon from './icons/MailIcon.astro';
import WorldIcon from './icons/WorldIcon.astro';
import MapPinIcon from './icons/MapPinIcon.astro';
import { SITE } from '../config/site';
import { CARD_REVISION } from '../config/cards';
import { type Lang, useTranslations } from '../i18n/ui';
import type { CardPerson } from '../config/cards';

interface Props {
  lang: Lang;
  person: CardPerson;
}

const { lang, person } = Astro.props;
const t = useTranslations(lang);
const base = lang === 'de' ? '' : '/en';
const path = lang === 'de' ? `/karte/${person.slug}` : `/en/card/${person.slug}`;
/* Meta titles join with – (DE) / — (EN), matching the ui.ts house style. */
const title = `${person.name} ${lang === 'de' ? '–' : '—'} ${SITE.name}`;
/* One vCard per person, shared by both languages — contact data has no language. */
const vcfHref = `/karte/${person.slug}.vcf`;

/* Every row is a real link. The address row points at the Impressum — the
   in-world home of the address, and no third-party map request. */
const rows = [
  // Display grouping matches the printed card (+49 173 9044077); the raw
  // Impressum spelling (01739044077) stays untouched in site.ts.
  {
    href: `tel:${SITE.phoneE164}`,
    label: t('card.row.phone'),
    value: SITE.phoneE164.replace(/^(\+49)(\d{3})(\d+)$/, '$1 $2 $3'),
    Icon: PhoneIcon,
  },
  { href: `mailto:${SITE.email}`, label: t('card.row.email'), value: SITE.email, Icon: MailIcon },
  {
    href: SITE.url,
    label: t('card.row.web'),
    value: SITE.url.replace(/^https:\/\//, ''),
    Icon: WorldIcon,
  },
  {
    href: `${base}/impressum`,
    label: t('card.row.address'),
    value: `${SITE.street}, ${SITE.zip} ${SITE.city}`,
    Icon: MapPinIcon,
  },
];
---

<Layout
  lang={lang}
  path={path}
  title={title}
  description={t('card.meta.description')}
  hasAlternate={false}
  noindex
>
  <CardHeader lang={lang} />

  <main id="main" class="relative">
    <div class="relative mx-auto w-full max-w-[26rem] px-6 pb-16 pt-10 sm:max-w-[28rem]">
      {/* The object: shadow and tilt wrapper are separate layers so press,
          tilt and floor shadow never fight over one transform. The whole
          plate is the vCard link — tap the card, save the contact. */}
      <div class="card-scene">
        <div class="card-shadow" aria-hidden="true"></div>
        <div class="card-tilt">
          <a
            id="card-obj"
            href={vcfHref}
            class="card-obj surface-signal-obj"
            aria-label={[t('card.save'), person.name, t('card.a11y.vcard')].join(
              lang === 'de' ? ' – ' : ' — ',
            )}
            data-icon-hover
          >
            <div class="card-face">
              <div class="card-el flex items-start justify-between gap-4">
                {/* Engraved monochrome wordmark — the period is graphite
                    here, not signal: ink on the plate is one color (D-049). */}
                <span class="type-wordmark card-wordmark">{SITE.name}.</span>
                <span class="type-annot">{person.partNo}</span>
              </div>

              {/* Engraved flow mark: groove inputs into the graphite output
                  line — the brand schematic as a stamp, not a diagram. */}
              <svg class="card-el card-mark" viewBox="0 0 96 64" fill="none" aria-hidden="true">
                <path
                  d="M0 8 H36 C52 8, 56 32, 68 32"
                  stroke="var(--color-groove)"
                  stroke-width="1.5"></path>
                <path d="M0 32 H68" stroke="var(--color-groove)" stroke-width="1.5"></path>
                <path
                  d="M0 56 H36 C52 56, 56 32, 68 32"
                  stroke="var(--color-groove)"
                  stroke-width="1.5"></path>
                <path d="M68 32 H88" stroke="var(--color-graphite)" stroke-width="2.5"></path>
                <path d="M96 32 L86 27 V37 Z" fill="var(--color-graphite)"></path>
              </svg>

              <h1 id="card-name" class="type-display card-name">
                {person.name}
              </h1>
              <p class="card-el type-annot card-role">{t(person.roleKey)}</p>

              <div class="card-el card-actions flex items-end justify-between gap-4">
                <span class="card-save inline-flex items-center gap-2 font-semibold">
                  {t('card.save')}
                  <CtaArrow size={18} />
                </span>
                {/* NFC wave glyph — how this page opened. */}
                <svg class="card-nfc" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path
                    d="M7 8 a7.5 7.5 0 0 1 0 8"
                    stroke="var(--color-graphite)"
                    stroke-width="1.5"></path>
                  <path
                    d="M11 5.5 a11.5 11.5 0 0 1 0 13"
                    stroke="var(--color-graphite)"
                    stroke-width="1.5"></path>
                  <path
                    d="M15 3 a15.5 15.5 0 0 1 0 18"
                    stroke="var(--color-graphite)"
                    stroke-width="1.5"></path>
                </svg>
              </div>
            </div>
            <span class="card-sheen" aria-hidden="true"></span>
          </a>
        </div>
      </div>

      {/* Contact: annotated rows — mono labels, Archivo values, every one a link */}
      <div class="mt-10 border-t border-steel-soft">
        {
          rows.map((row) => (
            <a
              href={row.href}
              class="card-row dim-row flex items-center gap-4 border-b border-steel-soft py-3.5"
              data-icon-hover
            >
              <row.Icon size={16} class="shrink-0 text-steel" />
              <span class="min-w-0 flex-1">
                <span class="type-annot block text-steel">{row.label}</span>
                <span class="mt-0.5 block truncate text-[0.95rem] text-paper">{row.value}</span>
              </span>
            </a>
          ))
        }
      </div>

      {/* Saving is the card itself; call/mail/share stand second rank */}
      <div class="card-stage mt-6 flex flex-wrap gap-3">
        <a
          href={`tel:${SITE.phoneE164}`}
          class="inline-flex min-h-11 items-center border border-steel-soft px-4 text-[0.9375rem] font-semibold text-paper transition-colors hover:border-steel motion-reduce:transition-none"
          >{t('card.call')}</a
        >
        <a
          href={`mailto:${SITE.email}`}
          class="inline-flex min-h-11 items-center border border-steel-soft px-4 text-[0.9375rem] font-semibold text-paper transition-colors hover:border-steel motion-reduce:transition-none"
          >{t('card.mail')}</a
        >
        {/* Ships hidden: a share button without JS is a dead control. The
            script reveals it once navigator.share or the clipboard exists. */}
        <button
          id="card-share"
          hidden
          data-label-copied={t('card.shareCopied')}
          class="inline-flex min-h-11 items-center border border-steel-soft px-4 text-[0.9375rem] font-semibold text-paper transition-colors hover:border-steel motion-reduce:transition-none"
        >
          <span aria-live="polite">{t('card.share')}</span>
        </button>
      </div>

      {/* The one annotation the stage allows itself: part number and stand. */}
      <p class="card-stage type-annot mt-8 text-steel">
        {person.partNo} · {t('tb.rev.label')} {CARD_REVISION}
      </p>
    </div>
  </main>

  <CardFooter lang={lang} path={path} />
</Layout>

<script>
  import { gsap, motionOff, SplitText, onPage } from '../scripts/motion';
  import { mountCardObject } from '../scripts/card-object';

  onPage(() => {
    /* Cheap bail on every non-card page — inits run on all mounts (D-038).
       The sentinel is the server-rendered h1, so the share wiring below can
       never be skipped by a missing decoration (D-049). */
    const h1 = document.getElementById('card-name');
    if (!h1) return;

    /* Share: capability-gated, NOT motion-gated — must work under ?snap and
       reduced motion. Web Share API first; clipboard copy as the fallback. */
    const share = document.querySelector<HTMLButtonElement>('#card-share');
    const shareLabel = share?.querySelector('span') ?? null;
    if (share && (navigator.share || navigator.clipboard)) {
      share.hidden = false;
      const restLabel = shareLabel?.textContent ?? '';
      share.addEventListener('click', async () => {
        const url = window.location.href;
        try {
          if (navigator.share) {
            await navigator.share({ title: document.title, url });
          } else {
            await navigator.clipboard.writeText(url);
            if (shareLabel) {
              shareLabel.textContent = share.dataset.labelCopied ?? restLabel;
              window.setTimeout(() => {
                shareLabel.textContent = restLabel;
              }, 2000);
            }
          }
        } catch {
          /* The visitor dismissed the share sheet — nothing to do. */
        }
      });
    }

    /* The object: tilt + idle loop live in card-object.ts. Under motionOff
       the handle is inert and the CSS defaults already show the finished
       still-life — nothing here builds furniture (D-049). */
    const card = document.getElementById('card-obj');
    const scene = card?.closest<HTMLElement>('.card-scene') ?? null;
    const handle = card && scene ? mountCardObject(card, scene) : null;

    /* Reality moves: re-cache the tilt geometry when the webfont lands or
       the viewport changes. */
    let resizeT = 0;
    const refit = () => handle?.refit();
    const onResize = () => {
      window.clearTimeout(resizeT);
      resizeT = window.setTimeout(refit, 200);
    };
    window.addEventListener('resize', onResize);
    document.fonts?.ready.then(refit);
    const unlisten = () => {
      window.removeEventListener('resize', onResize);
      window.clearTimeout(resizeT);
    };

    if (motionOff) return unlisten;

    /* Load sequence per DESIGN.md: the plate rises and settles under a
       one-time sheen sweep → the name rises out of blur → the rest of the
       engraving fades up → contact rows stagger → second-rank actions and
       the annotation land → the sheen starts drifting (the page's ONE
       loop). Markup ships visible; everything is hidden here, right before
       animating. */
    const sheen = card?.querySelector<HTMLElement>('.card-sheen') ?? null;
    const shadow = scene?.querySelector<HTMLElement>('.card-shadow') ?? null;
    const tiltEl = scene?.querySelector<HTMLElement>('.card-tilt') ?? null;
    const faceEls = Array.from(document.querySelectorAll<HTMLElement>('.card-el'));
    const stages = Array.from(document.querySelectorAll<HTMLElement>('.card-stage'));
    const rowEls = Array.from(document.querySelectorAll<HTMLElement>('.card-row'));

    let split: SplitText | null = null;
    const tl = gsap.timeline({ defaults: { ease: 'expo.out' } });

    /* 1 — the object arrives: rises and settles, the floor shadow catches up */
    if (scene && tiltEl) {
      gsap.set(scene, { opacity: 0, y: 56 });
      gsap.set(tiltEl, { rotationX: 10 });
      if (shadow) gsap.set(shadow, { opacity: 0 });
      tl.to(scene, { opacity: 1, y: 0, duration: 1.05 }, 0).to(
        tiltEl,
        { rotationX: 0, duration: 1.05 },
        0,
      );
      if (shadow) tl.to(shadow, { opacity: 1, duration: 0.9, clearProps: 'opacity' }, 0.15);
    }

    /* 2 — one-time sheen sweep while the plate settles, then re-park */
    if (sheen) {
      tl.set(sheen, { xPercent: -120, opacity: 0.3 }, 0.7)
        .to(sheen, { xPercent: 120, duration: 1.0, ease: 'power2.inOut' }, 0.7)
        .set(sheen, { opacity: 0.08 }, 1.7);
    }

    /* 3 — the name rises out of blur, character by character */
    split = new SplitText(h1, { type: 'chars,words', charsClass: 'card-char' });
    gsap.set(split.chars, { opacity: 0, yPercent: 110, filter: 'blur(10px)' });
    tl.to(
      split.chars,
      { opacity: 1, yPercent: 0, filter: 'blur(0px)', duration: 1, stagger: 0.022 },
      0.5,
    );

    /* 3b — the rest of the engraving fades up */
    if (faceEls.length) {
      gsap.set(faceEls, { opacity: 0 });
      tl.to(faceEls, { opacity: 1, duration: 0.85, stagger: 0.08 }, 0.7);
    }

    /* 4 — contact rows land on the dim-row curve */
    if (rowEls.length) {
      gsap.set(rowEls, { opacity: 0, y: 18 });
      tl.to(rowEls, { opacity: 1, y: 0, duration: 0.8, stagger: 0.085 }, 0.85);
    }

    /* 5 — second-rank actions and the annotation line */
    if (stages.length) {
      gsap.set(stages, { opacity: 0, y: 22 });
      tl.to(stages, { opacity: 1, y: 0, duration: 0.85, stagger: 0.1 }, 1.05);
    }

    /* 6 — the still-life is complete; the sheen drift takes over */
    tl.add(() => handle?.idle(), 1.9);

    return () => {
      unlisten();
      handle?.destroy();
      split?.revert();
    };
  });
</script>

<style>
  /* SplitText needs the chars to clip cleanly while they rise */
  :global(.card-char) {
    display: inline-block;
    will-change: transform, filter;
  }
  #card-name {
    overflow: hidden;
    padding-bottom: 0.08em;
  }
</style>
