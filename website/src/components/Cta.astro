---
/**
 * The primary CTA — one component instead of three drifted copies (D-043).
 * Renders <a> when href is given, <button> otherwise (the Contact submit).
 * Carries data-magnetic for the cursor and data-icon-hover for the arrow;
 * both attributes are inert on pages where their scripts do not run.
 * DESIGN.md: signal bg, graphite text, weight 600, arrow that extends on hover.
 */
import CtaArrow from './icons/CtaArrow.astro';

interface Props {
  href?: string;
  type?: 'submit' | 'button';
  magnetic?: string;
  size?: 'base' | 'lg';
  class?: string;
}
const { href, type, magnetic = '0.3', size = 'base', class: className } = Astro.props;
const Tag = href ? 'a' : 'button';
---

<Tag
  href={href}
  type={href ? undefined : (type ?? 'button')}
  data-magnetic={magnetic}
  data-icon-hover
  class:list={[
    'inline-flex items-center gap-3 bg-signal font-semibold text-graphite',
    size === 'lg' ? 'px-7 py-4' : 'px-6 py-3.5',
    className,
  ]}
>
  <slot />
  <CtaArrow />
</Tag>
