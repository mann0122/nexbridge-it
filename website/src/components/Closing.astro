---
import { type Lang, useTranslations } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

{/* Final CTA — the page's bookend: the hero's converging schematic returns,
    two muted lines resolving into the single action. Signal stays on the
    button only, so the accent budget holds. */}
<section id="kontakt" class="surface-grid border-t border-steel-soft">
  <div class="mx-auto max-w-[1200px] px-6 py-24 md:py-32" data-reveal-scope>
    <h2 class="type-display max-w-[16ch] text-[clamp(2.2rem,5vw,4.2rem)] text-paper" data-reveal>
      {t('closing.title')}
    </h2>
    <p class="mt-6 max-w-[50ch] text-lg leading-relaxed text-steel" data-reveal>
      {t('closing.sub')}
    </p>

    <div class="mt-12 flex flex-col items-start gap-0 md:flex-row md:items-center">
      <svg
        id="closing-flow"
        class="hidden h-[76px] w-[340px] shrink-0 lg:block"
        viewBox="0 0 340 76"
        fill="none"
        aria-hidden="true"
      >
        <path class="close-line" d="M0 12 H150 C 210 12, 220 38, 268 38" stroke="var(--color-steel-deep)" stroke-width="1.5" />
        <path class="close-line" d="M0 64 H150 C 210 64, 220 38, 268 38" stroke="var(--color-steel-deep)" stroke-width="1.5" />
        <path class="close-line" d="M268 38 H332" stroke="var(--color-steel-deep)" stroke-width="1.5" />
      </svg>

      <div data-reveal>
        {/* TBD: replace mailto with booking link / contact form provider */}
        <a
          href="mailto:kontakt@klarfluss.eu"
          class="group inline-flex items-center gap-3 bg-signal px-7 py-4 font-semibold text-graphite"
        >
          {t('closing.cta')}
          <span class="inline-block transition-transform duration-300 ease-out group-hover:translate-x-1.5" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  import { drawOnScroll } from '../scripts/motion';

  const svg = document.getElementById('closing-flow');
  if (svg) {
    drawOnScroll(svg, Array.from(svg.querySelectorAll<SVGPathElement>('.close-line')), { stagger: 0.12 });
  }
</script>
