---
import { SITE } from '../config/site';
import { type Lang, useTranslations, altPath } from '../i18n/ui';
import WorldIcon from './icons/WorldIcon.astro';

interface Props {
  lang: Lang;
  path: string;
  /** False on pages with no translated twin (legal pages) — hides the switch. */
  hasAlternate?: boolean;
}

const { lang, path, hasAlternate = true } = Astro.props;
const t = useTranslations(lang);
const base = lang === 'de' ? '' : '/en';
const switchHref = altPath(lang, path);

// Anchors into the landing page until dedicated subpages exist (D-010 scope).
const links = [
  { href: `${base}/#leistungen`, label: t('nav.leistungen') },
  { href: `${base}/#vorgehen`, label: t('nav.vorgehen') },
  { href: `${base}/#ueber-uns`, label: t('nav.ueberUns') },
  { href: `${base}/#kontakt`, label: t('nav.kontakt') },
];
---

<header class="sticky top-0 z-40 border-b border-steel-soft bg-graphite">
  <div class="mx-auto flex h-16 max-w-[1200px] items-center justify-between px-6">
    <a href={lang === 'de' ? '/' : '/en/'} class="group type-wordmark text-[1.35rem]">
      {SITE.name}<span
        class="inline-block text-signal transition-transform duration-200 ease-out group-hover:-translate-y-[0.08em] motion-reduce:transition-none motion-reduce:group-hover:translate-y-0"
        >.</span
      >
    </a>

    <nav class="hidden items-center gap-8 md:flex" aria-label={t('a11y.mainNav')}>
      {
        links.map((link) => (
          <a href={link.href} class="link-draw text-[0.9375rem] text-steel transition-colors hover:text-paper">
            {link.label}
          </a>
        ))
      }
      {
        hasAlternate && (
          <a
            href={switchHref}
            data-icon-hover
            class="type-annot ml-2 inline-flex items-center gap-2 border border-steel-soft px-2.5 py-1.5 text-steel transition-colors hover:border-steel hover:text-paper"
            aria-label={t('a11y.langSwitch')}
          >
            <WorldIcon size={14} class="shrink-0" />
            {lang === 'de' ? 'DE → EN' : 'EN → DE'}
          </a>
        )
      }
    </nav>

    <div class="flex items-center gap-4 md:hidden">
      {/* Parity with the desktop toggle (D-043): same icon, plus the hover
          classes it never had. */}
      {
        hasAlternate && (
          <a
            href={switchHref}
            data-icon-hover
            class="type-annot inline-flex items-center gap-2 border border-steel-soft px-2.5 py-1.5 text-steel transition-colors hover:border-steel hover:text-paper"
            aria-label={t('a11y.langSwitch')}
          >
            <WorldIcon size={14} class="shrink-0" />
            {lang === 'de' ? 'EN' : 'DE'}
          </a>
        )
      }
      <button
        id="menu-toggle"
        class="flex h-10 w-10 flex-col items-center justify-center gap-1.5"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label={t('a11y.menuOpen')}
        data-label-open={t('a11y.menuOpen')}
        data-label-close={t('a11y.menuClose')}
      >
        <span class="block h-px w-6 bg-paper transition-transform"></span>
        <span class="block h-px w-6 bg-paper transition-transform"></span>
      </button>
    </div>
  </div>

  {/* Full-screen graphite overlay per DESIGN.md */}
  <nav
    id="mobile-menu"
    class="surface-grid fixed inset-0 top-16 z-40 hidden bg-graphite md:hidden"
    aria-label={t('a11y.mainNav')}
  >
    <ul class="flex h-full flex-col gap-2 px-6 pt-10">
      {
        links.map((link) => (
          <li class="border-b border-steel-soft">
            <a href={link.href} class="type-display block py-5 text-3xl text-paper">
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  import { onPage } from '../scripts/motion';

  onPage(() => {
    const toggle = document.getElementById('menu-toggle');
    const menu = document.getElementById('mobile-menu');
    if (!toggle || !menu) return;

    function setMenu(open: boolean) {
      if (!toggle || !menu) return;
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute(
        'aria-label',
        (open ? toggle.dataset.labelClose : toggle.dataset.labelOpen) ?? '',
      );
      menu.classList.toggle('hidden', !open);
      document.body.style.overflow = open ? 'hidden' : '';
      const spans = toggle.querySelectorAll('span');
      spans[0]?.classList.toggle('translate-y-[3.5px]', open);
      spans[0]?.classList.toggle('rotate-45', open);
      spans[1]?.classList.toggle('-translate-y-[3.5px]', open);
      spans[1]?.classList.toggle('-rotate-45', open);
      if (open) menu.querySelector<HTMLAnchorElement>('a')?.focus();
    }

    toggle.addEventListener('click', () => {
      setMenu(toggle.getAttribute('aria-expanded') !== 'true');
    });

    // Escape closes and returns focus to the toggle; anchor clicks close too.
    const onKeydown = (e: KeyboardEvent) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setMenu(false);
        toggle.focus();
      }
    };
    document.addEventListener('keydown', onKeydown);

    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setMenu(false)));

    return () => {
      document.removeEventListener('keydown', onKeydown);
      // A page can be swapped away with the menu open; the scroll lock must
      // not survive onto the next page.
      document.body.style.overflow = '';
    };
  });
</script>
