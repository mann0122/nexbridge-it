---
/*
DIRECTION CONTRACT
THESIS: The site is an engineering document that demonstrates the craft it
sells; it refuses the dark-SaaS hero with floating gradients and stat cards.
OWN-WORLD: German drawing-office — graphite ground with faint graph grid,
paper reading sections, ONE signal-orange flowing line, steel hairlines,
DIN frame coordinates, Fragment Mono annotations, Archivo-expanded display.
STORY: A Geschäftsführer sees generic chaos converge through klarfluss into
one clean pulsing line → recognizes their pains (Positionsliste) → sees the
four services (part-numbered) → the three-phase process (scroll-drawn flow)
→ a labeled demo dashboard → the founders → books an Erstgespräch.
FIRST VIEWPORT: kicker, two-line display H1, subline, CTA pair; the working
schematic draws itself and keeps pulsing.
FORM: Signal-flow schematic (P&ID tradition), pinned by docs/02-brand.md.
*/
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Problems from '../components/Problems.astro';
import Services from '../components/Services.astro';
import Process from '../components/Process.astro';
import Demo from '../components/Demo.astro';
import Founders from '../components/Founders.astro';
import Story from '../components/Story.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import Marquee from '../components/Marquee.astro';
import Grain from '../components/Grain.astro';
import Cursor from '../components/Cursor.astro';
---

<Layout lang="de" path="/">
  <Grain />
  <Cursor />
  <Header lang="de" path="/" />
  <main id="main">
    <Hero lang="de" />
    <Problems lang="de" />
    <Services lang="de" />
    <Marquee lang="de" />
    <Process lang="de" />
    <Story lang="de" />
    <Demo lang="de" />
    <Founders lang="de" />
    <Contact lang="de" />
  </main>
  <Footer lang="de" />
</Layout>

<script>
  // One global pass: smooth scroll, then every section's reveal group once.
  import { initSmoothScroll, revealGroup } from '../scripts/motion';

  initSmoothScroll();

  document.querySelectorAll('[data-reveal-scope]').forEach((scope) => {
    revealGroup(scope, Array.from(scope.querySelectorAll('[data-reveal]')));
  });
</script>
