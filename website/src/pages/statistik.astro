---
/*
 * Statistik (D-063): the founders' datasheet for the self-hosted, cookieless
 * visit counts. Internal — not in the nav, noindex (which also drops the
 * canonical and the JSON-LD graph, exactly right for a page that publishes
 * nothing), and filtered out of the sitemap in astro.config.mjs.
 *
 * The numbers come from GET /api/stats on the Worker (worker/stats.js) behind
 * a key the founders hold; the page itself contains none of them.
 */
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StatsBoard from '../components/StatsBoard.astro';
import { useTranslations } from '../i18n/ui';

const t = useTranslations('de');
---

<Layout
  lang="de"
  path="/statistik"
  title={t('stats.meta.title')}
  description={t('stats.meta.description')}
  noindex
  hasAlternate={false}
>
  <Header lang="de" path="/statistik" />
  <main id="main">
    <StatsBoard lang="de" />
  </main>
  <Footer lang="de" />
</Layout>
