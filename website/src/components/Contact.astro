---
import { type Lang, useTranslations } from '../i18n/ui';
import { SITE } from '../config/site';
import Cta from './Cta.astro';
import PlugConnectedIcon from './icons/PlugConnectedIcon.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const trust = [t('trust.response'), t('trust.noSales'), t('trust.dataStays')];

// Consent link follows the reader's language now that /en/datenschutz exists.
const base = lang === 'de' ? '' : '/en';

// Handed to the client script as JSON so no customer-facing string is
// hardcoded in JavaScript (D-010).
const formStrings = {
  required: t('form.required'),
  invalidEmail: t('form.invalidEmail'),
  consentRequired: t('form.consentRequired'),
  sending: t('form.sending'),
  submit: t('form.submit'),
  success: t('form.success'),
  fallbackNote: t('form.fallbackNote'),
  name: t('form.name'),
  company: t('form.company'),
  email: t('form.email'),
  mailSubject: t('form.mailSubject'),
  mailMessageLabel: t('form.mailMessageLabel'),
  mailEmpty: t('form.mailEmpty'),
};
---

{/* The one place the page asks. The hero's converging schematic returns as a
    bookend, and the form replaces the old mailto: — a blank Outlook window is
    where enquiries went to die. */}
<section id="kontakt" class="surface-grid border-t border-steel-soft">
  {/* Inside the section on purpose: a loose child of <main> broke the seam
      system's structure guard (D-041 gate finding). */}
  <script id="form-strings" type="application/json" set:html={JSON.stringify(formStrings)} is:inline></script>
  <div class="mx-auto max-w-[1200px] px-6 py-24 md:py-32" data-reveal-scope>
    <div class="grid grid-cols-1 gap-14 lg:grid-cols-12 lg:gap-16">
      {/* left: the ask */}
      <div class="lg:col-span-5">
        <h2 class="type-display max-w-[14ch] text-[clamp(2.2rem,4.4vw,3.6rem)] text-paper" data-reveal>
          {t('closing.title')}
        </h2>
        <p class="mt-6 max-w-[46ch] text-lg leading-relaxed text-steel" data-reveal>
          {t('closing.sub')}
        </p>

        <ul class="mt-8 space-y-2.5" data-reveal>
          {
            trust.map((line) => (
              <li class="type-annot flex items-center gap-3 text-steel">
                <span class="inline-block h-1.5 w-1.5 shrink-0 bg-steel-deep" aria-hidden="true" />
                {line}
              </li>
            ))
          }
        </ul>

        {/* The signature, complete: 2 muted lines + 1 accent line converging.
            Shown from sm up so the lower page keeps its mark on mobile too. */}
        <svg class="mt-12 hidden h-[76px] w-[300px] sm:block" viewBox="0 0 300 76" fill="none" aria-hidden="true">
          <path class="close-line" d="M0 12 H130 C 190 12, 200 38, 248 38" stroke="var(--color-steel-deep)" stroke-width="1.5" />
          <path class="close-line" d="M0 64 H130 C 190 64, 200 38, 248 38" stroke="var(--color-steel-deep)" stroke-width="1.5" />
          <path class="close-line close-accent" d="M248 38 H292" stroke="var(--color-signal)" stroke-width="2.5" />
          <path class="close-arrow" d="M300 38 L286 31 V45 Z" fill="var(--color-signal)" opacity="0" />
        </svg>
      </div>

      {/* right: the form */}
      <div class="lg:col-span-7" data-reveal>
        {/* method=post so a JS failure never puts personal data in the query
            string; without an endpoint the noscript block below is the path. */}
        <form
          id="contact-form"
          class="space-y-6"
          method="post"
          action={SITE.formEndpoint || undefined}
          novalidate
          data-endpoint={SITE.formEndpoint}
          data-mail={SITE.email}
        >
          <noscript>
            <p class="mb-6 border border-steel-deep p-4 text-[0.9375rem] leading-relaxed text-steel">
              {t('form.noscript')}
              <a href={`mailto:${SITE.email}`} class="ml-1 text-paper underline">{SITE.email}</a>
            </p>
          </noscript>

          {/* honeypot — bots fill this, humans never see it */}
          <div class="absolute left-[-9999px]" aria-hidden="true">
            <label for="company-url">Website</label>
            <input id="company-url" name="company-url" type="text" tabindex="-1" autocomplete="off" />
          </div>

          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
            <div class="field">
              <label class="type-annot text-steel" for="cf-name">{t('form.name')}</label>
              <input id="cf-name" name="name" type="text" required autocomplete="name" aria-describedby="cf-name-err" />
              <p class="err" id="cf-name-err" data-err-for="cf-name"></p>
            </div>
            <div class="field">
              <label class="type-annot text-steel" for="cf-company">{t('form.company')}</label>
              <input id="cf-company" name="company" type="text" autocomplete="organization" />
            </div>
          </div>

          <div class="field">
            <label class="type-annot text-steel" for="cf-email">{t('form.email')}</label>
            <input id="cf-email" name="email" type="email" required autocomplete="email" aria-describedby="cf-email-err" />
            <p class="err" id="cf-email-err" data-err-for="cf-email"></p>
          </div>

          <div class="field">
            <label class="type-annot text-steel" for="cf-message">{t('form.message')}</label>
            <textarea id="cf-message" name="message" rows="4" placeholder={t('form.messagePlaceholder')}></textarea>
          </div>

          <div class="field">
            <label class="flex cursor-pointer items-start gap-3 text-[0.875rem] leading-relaxed text-steel">
              <input
                id="cf-consent"
                name="consent"
                type="checkbox"
                required
                class="consent mt-1 shrink-0"
                aria-describedby="cf-consent-err"
              />
              <span>
                {t('form.consent')}{' '}
                {t('form.consentMore')}{' '}
                <a href={`${base}/datenschutz`} class="link-draw text-paper">{t('form.consentLink')}</a>.
              </span>
            </label>
            <p class="err" id="cf-consent-err" data-err-for="cf-consent"></p>
          </div>

          <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
            <Cta type="submit" magnetic="0.25" size="lg">
              <span data-submit-label>{t('form.submit')}</span>
            </Cta>
            <p class="type-annot text-steel">
              {t('form.orMail')}
              {/* The founder-named plug (D-043): contact made. Rests steel,
                  joins the text's paper on hover like the nav links. */}
              <a
                href={`mailto:${SITE.email}`}
                data-icon-hover
                class="group link-draw ml-1.5 inline-flex items-center gap-1.5 text-paper"
              >
                <PlugConnectedIcon
                  size={15}
                  class="shrink-0 text-steel transition-colors duration-200 group-hover:text-paper motion-reduce:transition-none"
                />
                {SITE.email}
              </a>
            </p>
          </div>

          <p id="form-status" class="type-annot leading-relaxed" role="status" aria-live="polite"></p>
        </form>
      </div>
    </div>
  </div>
</section>

<style>
  /* Reset is scoped to text controls only — the native checkbox keeps its
     own focus ring. Border is steel-deep (3.03:1) so the field boundary
     itself meets SC 1.4.11. */
  .field input[type='text'],
  .field input[type='email'],
  .field textarea {
    width: 100%;
    margin-top: 0.5rem;
    padding: 0.75rem 0.9rem;
    background: transparent;
    border: 1px solid var(--color-steel-deep);
    color: var(--color-paper);
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    transition: border-color 200ms ease;
  }
  .field input::placeholder,
  .field textarea::placeholder {
    color: var(--color-steel);
  }
  .field input[type='text']:hover,
  .field input[type='email']:hover,
  .field textarea:hover {
    border-color: var(--color-steel);
  }
  /* Focus = the global signal outline ring (kept, not suppressed).
     Error = a thick left rule. The two are never confusable. */
  .field textarea {
    resize: vertical;
  }
  .consent {
    width: 1.05rem;
    height: 1.05rem;
    accent-color: var(--color-signal);
  }
  .err {
    display: none;
    margin-top: 0.45rem;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--color-signal);
  }
  .err.is-shown {
    display: block;
  }
  /* Error state: the whole field is marked, not a side tab — DESIGN.md bans
     colored left-borders >1px, and its own .err line below carries the alarm. */
  .field.has-error input[type='text'],
  .field.has-error input[type='email'],
  .field.has-error textarea {
    border-color: var(--color-signal);
  }
  #form-status {
    color: var(--color-steel);
  }
  #form-status.is-success {
    color: var(--color-paper);
  }
</style>

<script>
  import { gsap, motionOff, drawOnScroll, onPage } from '../scripts/motion';

  onPage(() => {
    const svg = document.querySelector('#kontakt svg');
    if (svg) {
      drawOnScroll(svg, Array.from(svg.querySelectorAll<SVGPathElement>('.close-line')), { stagger: 0.12 });
      // The arrowhead can't be drawn (it's a fill) — fade it in once its line
      // has arrived, so the point never precedes the stroke.
      const arrow = svg.querySelector('.close-arrow');
      if (arrow) {
        if (motionOff) gsap.set(arrow, { opacity: 1 });
        else
          gsap.to(arrow, {
            opacity: 1,
            duration: 0.3,
            scrollTrigger: { trigger: svg, start: 'top 72%' },
            delay: 1.15,
          });
      }
    }

    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    if (!form) return;
    const status = document.getElementById('form-status')!;
    const label = form.querySelector('[data-submit-label]')!;
    const strings = JSON.parse(document.getElementById('form-strings')!.textContent!);

    const setError = (id: string, msg: string) => {
      const input = document.getElementById(id)!;
      const field = input.closest('.field')!;
      const err = form.querySelector(`[data-err-for="${id}"]`)!;
      field.classList.toggle('has-error', Boolean(msg));
      input.setAttribute('aria-invalid', msg ? 'true' : 'false');
      err.textContent = msg;
      err.classList.toggle('is-shown', Boolean(msg));
      return !msg;
    };

    const validate = () => {
      const name = (document.getElementById('cf-name') as HTMLInputElement).value.trim();
      const email = (document.getElementById('cf-email') as HTMLInputElement).value.trim();
      const consent = (document.getElementById('cf-consent') as HTMLInputElement).checked;

      const okName = setError('cf-name', name ? '' : strings.required);
      const okEmail = setError('cf-email', /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email) ? '' : strings.invalidEmail);
      const okConsent = setError('cf-consent', consent ? '' : strings.consentRequired);

      // Send the keyboard straight to the first thing that needs fixing.
      if (!okName) document.getElementById('cf-name')!.focus();
      else if (!okEmail) document.getElementById('cf-email')!.focus();
      else if (!okConsent) document.getElementById('cf-consent')!.focus();

      return okName && okEmail && okConsent;
    };

    // Clear a field's error as soon as the visitor fixes it.
    ['cf-name', 'cf-email'].forEach((id) => {
      document.getElementById(id)!.addEventListener('input', () => setError(id, ''));
    });
    document.getElementById('cf-consent')!.addEventListener('change', () => setError('cf-consent', ''));

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      // Honeypot: silently accept and drop.
      if ((form.elements.namedItem('company-url') as HTMLInputElement).value) return;
      if (!validate()) return;

      const data = new FormData(form);
      const endpoint = form.dataset.endpoint;
      const mail = form.dataset.mail!;

      if (endpoint) {
        label.textContent = strings.sending;
        try {
          const res = await fetch(endpoint, { method: 'POST', body: data });
          if (!res.ok) throw new Error(String(res.status));
          form.reset();
          status.textContent = strings.success;
          status.classList.add('is-success');
          label.textContent = strings.submit;
          return;
        } catch {
          // fall through to the mail client — never lose an enquiry
          label.textContent = strings.submit;
        }
      }

      // No endpoint configured (or it failed): hand the finished message to
      // the visitor's mail client instead of dropping the enquiry.
      const body = [
        `${strings.name}: ${data.get('name')}`,
        `${strings.company}: ${data.get('company') || strings.mailEmpty}`,
        `${strings.email}: ${data.get('email')}`,
        '',
        `${strings.mailMessageLabel}:`,
        String(data.get('message') || strings.mailEmpty),
      ].join('\n');
      const subject = `${strings.mailSubject} – ${data.get('company') || data.get('name')}`;
      status.textContent = strings.fallbackNote;
      status.classList.add('is-success');
      window.location.href = `mailto:${mail}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    });
  });
</script>
