---
/**
 * The CTA arrow — DESIGN.md's "arrow that extends on hover", finally as real
 * geometry instead of a translated → character (D-043). A 2.5-weight action
 * line (the flow-line's weight, reserved for exactly this) lengthens into a
 * fixed filled head; shaft end and head base stay butt-jointed in both states
 * because both travel the same 4.2 units. Vocabulary: line + filled triangle,
 * as in the Contact closing signature.
 */
interface Props {
  size?: number;
  class?: string;
}
const { size = 18, class: className } = Astro.props;
---

<svg
  class:list={['icn-cta', className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  aria-hidden="true"
>
  <path class="icn-cta-line" d="M4 12h10.5" stroke="currentColor" stroke-width="2.5"></path>
  <path class="icn-cta-head" d="M21 12 14.5 8.4v7.2Z" fill="currentColor"></path>
</svg>

{/* Styles live in global.css (D-043 icon system section). */}
