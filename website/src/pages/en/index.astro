---
// English twin of / — same composition, dictionary-driven (see src/i18n/ui.ts).
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Hero from '../../components/Hero.astro';
import Problems from '../../components/Problems.astro';
import Services from '../../components/Services.astro';
import Process from '../../components/Process.astro';
import Demo from '../../components/Demo.astro';
import Founders from '../../components/Founders.astro';
import Story from '../../components/Story.astro';
import Contact from '../../components/Contact.astro';
import Footer from '../../components/Footer.astro';
import Marquee from '../../components/Marquee.astro';
import Grain from '../../components/Grain.astro';
import Cursor from '../../components/Cursor.astro';
import Ribbons from '../../components/Ribbons.astro';
---

<Layout lang="en" path="/en/">
  <Grain />
  <Cursor />
  {/* Keep in step with the German twin — same trail, same tuning (D-037). */}
  <Ribbons
    fixed
    colors={['--color-signal']}
    baseSpring={0.04}
    baseFriction={0.9}
    baseThickness={18}
    opacity={0.45}
    offsetFactor={0.05}
    maxAge={600}
    pointCount={40}
    speedMultiplier={0.6}
    enableFade
    enableShaderEffect
    effectAmplitude={2}
  />
  <Header lang="en" path="/en/" />
  <main id="main">
    <Hero lang="en" />
    <Problems lang="en" />
    <Services lang="en" />
    <Marquee lang="en" />
    <Process lang="en" />
    <Story lang="en" />
    <Demo lang="en" />
    <Founders lang="en" />
    <Contact lang="en" />
  </main>
  <Footer lang="en" />
</Layout>

<script>
  import { initSmoothScroll, revealGroup } from '../../scripts/motion';

  initSmoothScroll();

  document.querySelectorAll('[data-reveal-scope]').forEach((scope) => {
    revealGroup(scope, Array.from(scope.querySelectorAll('[data-reveal]')));
  });
</script>
