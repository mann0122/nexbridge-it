---
/**
 * Generative flow field — the brand's "Fluss" rendered as physics.
 * Particles trace a value-noise vector field left→right; a rationed minority
 * carries the signal colour. Nothing is downloaded: the field is generated at
 * runtime, so it is never identical twice and costs no request.
 *
 * Two layers, deliberately:
 *   1. a full field painted SYNCHRONOUSLY on init — the artwork always exists,
 *      even where the frame clock is throttled (background tabs, headless
 *      capture, reduced-motion users);
 *   2. live particles animating on top when motion is allowed.
 * Sits behind the hero — atmosphere, never competition with the headline.
 *
 * Runs on gsap.ticker, not its own rAF — one frame clock per D-030 (D-038
 * closed the gap D-037 logged). Mounted per page via onPage so the canvas
 * is re-found and repainted after every ClientRouter swap.
 */
---

<canvas id="flow-field" class="flow-field pointer-events-none absolute inset-0 h-full w-full" aria-hidden="true"></canvas>

<style>
  /* Directional mask: quiet where the headline sits, full strength where the
     flow exits right. Keeps type legible and reinforces the reading direction. */
  .flow-field {
    -webkit-mask-image: linear-gradient(
      to right,
      rgba(0, 0, 0, 0.15) 0%,
      rgba(0, 0, 0, 0.3) 28%,
      rgba(0, 0, 0, 0.85) 62%,
      rgba(0, 0, 0, 1) 100%
    );
    mask-image: linear-gradient(
      to right,
      rgba(0, 0, 0, 0.15) 0%,
      rgba(0, 0, 0, 0.3) 28%,
      rgba(0, 0, 0, 0.85) 62%,
      rgba(0, 0, 0, 1) 100%
    );
  }
</style>

<script>
  import { gsap, motionOff, ScrollTrigger, onPage } from '../scripts/motion';

  onPage(() => {
    const canvas = document.getElementById('flow-field') as HTMLCanvasElement | null;
    if (!canvas) return;

    const ctx = canvas.getContext('2d')!;
    const DPR = Math.min(window.devicePixelRatio || 1, 2);

    /* Stroke colours resolve from the @theme tokens at mount — same contract
       as Ribbons. The fallbacks only exist for a hostile environment where
       getComputedStyle yields nothing; they are the tokens' own values. */
    const hexToRgb = (hex: string): string | null => {
      const m = /^#([0-9a-f]{6})$/i.exec(hex);
      if (!m) return null;
      const n = parseInt(m[1], 16);
      return `${(n >> 16) & 255},${(n >> 8) & 255},${n & 255}`;
    };
    const token = (name: string, fallback: string): string =>
      hexToRgb(getComputedStyle(document.documentElement).getPropertyValue(name).trim()) ?? fallback;
    const SIGNAL_RGB = token('--color-signal', '255,77,0');
    const STEEL_RGB = token('--color-steel', '139,149,158');

    /* ---- value noise (dependency-free, reseeded each mount) ------------- */
    const perm = new Uint8Array(512);
    const seed = Math.random() * 10000;
    for (let i = 0; i < 256; i++) perm[i] = i;
    for (let i = 255; i > 0; i--) {
      const j = Math.floor(((Math.sin(seed + i) + 1) / 2) * (i + 1));
      const t = perm[i];
      perm[i] = perm[j];
      perm[j] = t;
    }
    for (let i = 0; i < 256; i++) perm[i + 256] = perm[i];

    const fade = (t: number) => t * t * t * (t * (t * 6 - 15) + 10);
    const lerp = (a: number, b: number, t: number) => a + t * (b - a);
    const grad = (h: number, x: number, y: number) => {
      const q = h & 3;
      const u = q < 2 ? x : y;
      const v = q < 2 ? y : x;
      return ((q & 1) === 0 ? u : -u) + ((q & 2) === 0 ? v : -v);
    };
    function noise(x: number, y: number): number {
      const X = Math.floor(x) & 255;
      const Y = Math.floor(y) & 255;
      x -= Math.floor(x);
      y -= Math.floor(y);
      const u = fade(x);
      const v = fade(y);
      const A = perm[X] + Y;
      const B = perm[X + 1] + Y;
      return lerp(
        lerp(grad(perm[A], x, y), grad(perm[B], x - 1, y), u),
        lerp(grad(perm[A + 1], x, y - 1), grad(perm[B + 1], x - 1, y - 1), u),
        v,
      );
    }

    const SCALE = 0.0013; // field zoom — low = long sweeping curves
    const STEP = 1.5;
    const angleAt = (x: number, y: number) => noise(x * SCALE, y * SCALE) * Math.PI * 1.6;
    // Rightward bias: the field flows, it does not swirl aimlessly.
    const vecAt = (a: number) => [Math.cos(a) * 0.55 + 0.85, Math.sin(a) * 0.9];

    interface P { x: number; y: number; life: number; max: number; signal: boolean; w: number }
    let W = 0;
    let H = 0;
    let particles: P[] = [];
    let running = false;

    /* Dispersion (D-040): 0 = laminar flow, 1 = the field blasted apart.
       Two sources, blended by max — the scroll scrub (leaving the hero
       disperses the field, scrolling back re-forms it) and the one-shot
       route-exit blast fired by transitions.ts. The effect lives inside
       the canvas the hero already owns: no third canvas, D-035 lesson 2
       untouched. */
    let scrollD = 0;
    let blastD = 0;
    let cx = 0;
    let cy = 0;
    const smoothstep = (a: number, b: number, x: number) => {
      const t = Math.min(1, Math.max(0, (x - a) / (b - a)));
      return t * t * (3 - 2 * t);
    };

    const COUNT = () => (window.innerWidth < 768 ? 55 : 140);

    function make(atRandomX: boolean): P {
      return {
        x: atRandomX ? Math.random() * W : -20 - Math.random() * 140,
        y: Math.random() * H,
        life: 0,
        max: 260 + Math.random() * 420,
        signal: Math.random() < 0.06, // rationed accent, as in the design system
        w: Math.random() < 0.22 ? 1.3 : 0.7,
      };
    }

    /** One complete field, drawn immediately — this is the artwork. */
    function paintStatic(streams: number) {
      for (let n = 0; n < streams; n++) {
        const p = make(true);
        // Start off-canvas-left sometimes so streams enter from the edge.
        if (n % 3 === 0) p.x = -Math.random() * 120;
        let x = p.x;
        let y = p.y;
        for (let s = 0; s < 420; s++) {
          const [vx, vy] = vecAt(angleAt(x, y));
          const nx = x + vx * STEP;
          const ny = y + vy * STEP;
          // Taper the ends so streams fade in and out instead of stopping dead.
          const t = s / 420;
          const taper = Math.min(1, t * 6) * Math.min(1, (1 - t) * 4);
          ctx.beginPath();
          ctx.moveTo(x, y);
          ctx.lineTo(nx, ny);
          ctx.lineWidth = p.w;
          ctx.strokeStyle = p.signal
            ? `rgba(${SIGNAL_RGB},${0.4 * taper})`
            : `rgba(${STEEL_RGB},${0.22 * taper})`;
          ctx.stroke();
          x = nx;
          y = ny;
          if (x > W + 60 || y < -60 || y > H + 60) break;
        }
      }
    }

    function resize() {
      const rect = canvas!.getBoundingClientRect();
      W = Math.max(1, rect.width);
      H = Math.max(1, rect.height);
      canvas!.width = Math.floor(W * DPR);
      canvas!.height = Math.floor(H * DPR);
      ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
      ctx.clearRect(0, 0, W, H);
      paintStatic(window.innerWidth < 768 ? 70 : 150);
      particles = Array.from({ length: COUNT() }, () => make(true));
      // Blast origin: pushed toward the schematic's side of the frame —
      // close enough that the radial read is "the block let go", without
      // paying for a per-resize rect measurement.
      cx = W * 0.55;
      cy = H * 0.5;
    }

    function frame() {
      const d0 = Math.max(scrollD, blastD);
      const d = d0 * d0; // ease-in: nothing happens until you really leave

      // Trail decay: erase the ground slightly instead of clearing outright,
      // so the static field slowly gives way to the live one. Low decay at
      // blast onset lets the streaks smear long; near full dispersion it
      // ramps up so the whole field — static ground included — evaporates.
      ctx.globalCompositeOperation = 'destination-out';
      ctx.fillStyle = `rgba(0,0,0,${0.012 + smoothstep(0.55, 1, d) * 0.07})`;
      ctx.fillRect(0, 0, W, H);
      ctx.globalCompositeOperation = 'source-over';

      for (let i = 0; i < particles.length; i++) {
        const p = particles[i];
        if (p.life > p.max) {
          // Parked while the field is blasted: the sky empties. Recycling
          // resumes as the scrub comes back and the field re-forms.
          if (d < 0.6) particles[i] = make(false);
          continue;
        }
        const [fx, fy] = vecAt(angleAt(p.x, p.y));
        let vx = fx;
        let vy = fy;
        let speed = 1.4;
        if (d > 0) {
          // Mix the flow vector toward a radial impulse from the blast
          // origin; debris drifts slightly upward. Streak length falls out
          // of speed alone — no extra draw cost.
          const dx = p.x - cx;
          const dy = p.y - cy;
          const inv = 1 / (Math.hypot(dx, dy) + 24);
          vx = fx * (1 - d) + dx * inv * 3.2 * d;
          vy = fy * (1 - d) + (dy * inv * 3.2 - 0.4) * d;
          speed = 1.4 + d * 9;
        }
        const nx = p.x + vx * speed;
        const ny = p.y + vy * speed;
        const a = Math.min(1, p.life / 45) * Math.min(1, (p.max - p.life) / 80) * (1 - 0.8 * d);
        ctx.beginPath();
        ctx.moveTo(p.x, p.y);
        ctx.lineTo(nx, ny);
        ctx.lineWidth = p.w;
        ctx.strokeStyle = p.signal ? `rgba(${SIGNAL_RGB},${a * 0.5})` : `rgba(${STEEL_RGB},${a * 0.3})`;
        ctx.stroke();
        p.x = nx;
        p.y = ny;
        p.life++;
        if (p.life > p.max || p.x > W + 50 || p.y < -50 || p.y > H + 50) {
          if (d < 0.6) particles[i] = make(false);
          else p.life = p.max + 1;
        }
      }
    }

    function start() {
      if (running || motionOff) return;
      running = true;
      gsap.ticker.add(frame);
    }
    function stop() {
      if (!running) return;
      running = false;
      gsap.ticker.remove(frame);
    }

    resize();
    start();

    /* Scroll-scrubbed dispersion: leaving the hero IS the transition. The
       scrub reverses, so scrolling back re-forms the field; once it has
       fully evaporated (peak > 0.5) the static ground is repainted softly
       on return, because decay erased it as part of the effect. */
    let peak = 0;
    if (!motionOff) {
      ScrollTrigger.create({
        trigger: canvas.closest('section') ?? canvas,
        start: 'top top',
        end: 'bottom 35%',
        scrub: 0.5,
        onUpdate: (self) => {
          scrollD = self.progress;
          peak = Math.max(peak, scrollD);
          if (scrollD < 0.04 && peak > 0.5) {
            peak = 0;
            paintStatic(30);
          }
        },
      });
    }

    /* Route-exit blast, fired by transitions.ts just before the veil slides
       across. power4.out: most of the motion lands in the first 150ms, the
       sheet covers at ~450ms — the field is visibly torn apart, not gone.
       One-way by design; the page underneath is being swapped away. */
    const blastState = { v: 0 };
    const onBlast = () => {
      if (motionOff) return;
      gsap.to(blastState, {
        v: 1,
        duration: 0.45,
        ease: 'power4.out',
        overwrite: true,
        onUpdate: () => (blastD = blastState.v),
      });
    };
    document.addEventListener('flowfield:blast', onBlast);

    // Webfonts change the hero's height; re-measure and repaint once settled.
    // Only relevant while the initial document is still loading — after a
    // ClientRouter swap the fonts are long since in.
    const onLoad = () => {
      stop();
      resize();
      start();
    };
    if (document.readyState !== 'complete') window.addEventListener('load', onLoad, { once: true });

    let resizeTimer = 0;
    const onResize = () => {
      clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        // Mobile URL-bar show/hide fires resize with the width unchanged; a
        // full repaint mid-scroll is a visible pop. The sub-pixel vertical
        // stretch from skipping it is invisible on a noise field.
        if (Math.abs(canvas!.getBoundingClientRect().width - W) < 1) return;
        stop();
        resize();
        start();
      }, 150);
    };
    window.addEventListener('resize', onResize);

    // Pause when off-screen or hidden — never the gate that decides whether
    // the field exists, only whether it keeps moving.
    const io = new IntersectionObserver(
      (entries) => (entries.some((e) => e.isIntersecting) ? start() : stop()),
      { threshold: 0 },
    );
    io.observe(canvas);
    const onVis = () => (document.hidden ? stop() : start());
    document.addEventListener('visibilitychange', onVis);

    return () => {
      stop();
      clearTimeout(resizeTimer);
      window.removeEventListener('load', onLoad);
      window.removeEventListener('resize', onResize);
      document.removeEventListener('visibilitychange', onVis);
      document.removeEventListener('flowfield:blast', onBlast);
      // The blast tween is born in an event callback the page context never
      // saw; the ScrollTrigger above IS context-owned and dies with it.
      gsap.killTweensOf(blastState);
      io.disconnect();
    };
  });
</script>
