---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource/fragment-mono';
import '../styles/global.css';
import { SITE } from '../config/site';
import { type Lang, useTranslations, altPath } from '../i18n/ui';

interface Props {
  lang: Lang;
  /** Current path, used for hreflang alternates. */
  path: string;
  title?: string;
  description?: string;
  /** False for pages that exist in one language only (legal pages). */
  hasAlternate?: boolean;
}

const { lang, path, title, description, hasAlternate = true } = Astro.props;
const t = useTranslations(lang);
const metaTitle = title ?? t('meta.title');
const metaDescription = description ?? t('meta.description');
const alternate = altPath(lang, path);
const canonical = new URL(path, SITE.url).href;
const alternateUrl = new URL(alternate, SITE.url).href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{metaTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    {
      hasAlternate && (
        <>
          <link rel="alternate" hreflang={lang === 'de' ? 'en' : 'de'} href={alternateUrl} />
          <link rel="alternate" hreflang={lang} href={canonical} />
          <link rel="alternate" hreflang="x-default" href={new URL(lang === 'de' ? path : alternate, SITE.url).href} />
        </>
      )
    }
    <meta name="generator" content={Astro.generator} />
    <meta property="og:title" content={metaTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og.png', SITE.url).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="theme-color" content="#14171A" />
  </head>
  <body>
    <a
      href="#main"
      class="type-annot absolute left-4 top-4 z-50 -translate-y-24 bg-signal px-3 py-2 text-graphite transition-transform focus:translate-y-0"
      >{t('a11y.skip')}</a
    >
    <slot />
  </body>
</html>
