{
  // Static-asset Worker (Cloudflare's current path for static sites; Pages is
  // in maintenance mode for new projects). `npm run build` first, then:
  //   npx wrangler deploy              → deploys to the logged-in account
  //   npx wrangler deploy --temporary  → throwaway preview, no login needed
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nexbridge-it-site",
  "compatibility_date": "2026-07-01",
  // The one script on the site: serves the teaser videos as 206 Partial
  // Content, which Safari/iOS require before they will play a <video>. The
  // asset store alone answers Range requests with the whole file (D-062).
  // Since D-063 it also answers the two stats routes under /api/ — the
  // beacon's POST and the dashboard's aggregate feed (worker/stats.js).
  "main": "./worker/index.js",
  // Workers Logs for the script's own console output — the only way to see a
  // failed stats write, since the beacon gets its 204 before the row lands.
  // Invocation logs OFF (D-064): they would record every /api/hit request
  // with its headers in our account, which is exactly the server log the
  // Datenschutzerklärung says we do not keep. Only our own console lines
  // land, and those carry no IP or agent string.
  "observability": { "enabled": true, "logs": { "invocation_logs": false } },
  // Housekeeping for the stats (D-064): every day at 00:07 UTC the Worker's
  // scheduled handler deletes the previous days' salts — so the deletion the
  // Datenschutz text promises does not wait for the next visitor — and rows
  // older than the retention period (worker/stats.js).
  "triggers": { "crons": ["7 0 * * *"] },
  // The stats store (D-063): created 2026-09-16 in region WEUR (Western
  // Europe — a location is fixed at creation, so it was chosen, not left to
  // wrangler's default of wherever the founder happened to be). Schema via
  //   npm run stats:migrate                     → applies worker/migrations/
  //   npx wrangler secret put STATS_KEY         → the dashboard's key
  // `wrangler dev` uses a local SQLite under .wrangler/ instead; migrate it
  // with `npm run stats:migrate:local` and put STATS_KEY in .dev.vars.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nexbridge-stats",
      "database_id": "a75285a4-96e3-450c-9410-2269b4757497",
      "migrations_dir": "./worker/migrations"
    }
  ],
  // Custom domains (nexbridge-it.com + www) are attached in the Cloudflare
  // DASHBOARD, not here: the wrangler OAuth token has no dns_records:write,
  // so declaring them as `routes` makes every deploy fail on the DNS step.
  // Dashboard-attached domains survive `wrangler deploy` — leave this out.
  "assets": {
    "directory": "./dist",
    // Astro emits /impressum/index.html; the footer links to /impressum.
    // Without this, that link 404s.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    // Only files under /teaser/ (the script acts on the .mp4s and passes the
    // two posters through) and the /api/ stats routes go through the script;
    // the teaser page itself and every other route stay pure static assets
    // (free, unlimited, no script).
    "run_worker_first": ["/teaser/*", "!/teaser", "!/teaser/", "/api/*"]
  }
}
