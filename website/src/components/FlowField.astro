---
/**
 * Generative flow field — the brand's "Fluss" rendered as physics.
 * Particles trace a value-noise vector field left→right; a rationed minority
 * carries the signal colour. Nothing is downloaded: the field is generated at
 * runtime, so it is never identical twice and costs no request.
 *
 * Two layers, deliberately:
 *   1. a full field painted SYNCHRONOUSLY on init — the artwork always exists,
 *      even where requestAnimationFrame is throttled (background tabs,
 *      headless capture, reduced-motion users);
 *   2. live particles animating on top when motion is allowed.
 * Sits behind the hero — atmosphere, never competition with the headline.
 */
---

<canvas id="flow-field" class="flow-field pointer-events-none absolute inset-0 h-full w-full" aria-hidden="true"></canvas>

<style>
  /* Directional mask: quiet where the headline sits, full strength where the
     flow exits right. Keeps type legible and reinforces the reading direction. */
  .flow-field {
    -webkit-mask-image: linear-gradient(
      to right,
      rgba(0, 0, 0, 0.15) 0%,
      rgba(0, 0, 0, 0.3) 28%,
      rgba(0, 0, 0, 0.85) 62%,
      rgba(0, 0, 0, 1) 100%
    );
    mask-image: linear-gradient(
      to right,
      rgba(0, 0, 0, 0.15) 0%,
      rgba(0, 0, 0, 0.3) 28%,
      rgba(0, 0, 0, 0.85) 62%,
      rgba(0, 0, 0, 1) 100%
    );
  }
</style>

<script>
  const canvas = document.getElementById('flow-field') as HTMLCanvasElement | null;
  const reduced =
    window.matchMedia('(prefers-reduced-motion: reduce)').matches ||
    new URLSearchParams(window.location.search).has('snap');

  if (canvas) {
    const ctx = canvas.getContext('2d')!;
    const DPR = Math.min(window.devicePixelRatio || 1, 2);

    /* ---- value noise (dependency-free, reseeded each load) -------------- */
    const perm = new Uint8Array(512);
    const seed = Math.random() * 10000;
    for (let i = 0; i < 256; i++) perm[i] = i;
    for (let i = 255; i > 0; i--) {
      const j = Math.floor(((Math.sin(seed + i) + 1) / 2) * (i + 1));
      const t = perm[i];
      perm[i] = perm[j];
      perm[j] = t;
    }
    for (let i = 0; i < 256; i++) perm[i + 256] = perm[i];

    const fade = (t: number) => t * t * t * (t * (t * 6 - 15) + 10);
    const lerp = (a: number, b: number, t: number) => a + t * (b - a);
    const grad = (h: number, x: number, y: number) => {
      const q = h & 3;
      const u = q < 2 ? x : y;
      const v = q < 2 ? y : x;
      return ((q & 1) === 0 ? u : -u) + ((q & 2) === 0 ? v : -v);
    };
    function noise(x: number, y: number): number {
      const X = Math.floor(x) & 255;
      const Y = Math.floor(y) & 255;
      x -= Math.floor(x);
      y -= Math.floor(y);
      const u = fade(x);
      const v = fade(y);
      const A = perm[X] + Y;
      const B = perm[X + 1] + Y;
      return lerp(
        lerp(grad(perm[A], x, y), grad(perm[B], x - 1, y), u),
        lerp(grad(perm[A + 1], x, y - 1), grad(perm[B + 1], x - 1, y - 1), u),
        v,
      );
    }

    const SCALE = 0.0013; // field zoom — low = long sweeping curves
    const STEP = 1.5;
    const angleAt = (x: number, y: number) => noise(x * SCALE, y * SCALE) * Math.PI * 1.6;
    // Rightward bias: the field flows, it does not swirl aimlessly.
    const vecAt = (a: number) => [Math.cos(a) * 0.55 + 0.85, Math.sin(a) * 0.9];

    interface P { x: number; y: number; life: number; max: number; signal: boolean; w: number }
    let W = 0;
    let H = 0;
    let particles: P[] = [];
    let running = false;
    let raf = 0;

    const COUNT = () => (window.innerWidth < 768 ? 55 : 140);

    function make(atRandomX: boolean): P {
      return {
        x: atRandomX ? Math.random() * W : -20 - Math.random() * 140,
        y: Math.random() * H,
        life: 0,
        max: 260 + Math.random() * 420,
        signal: Math.random() < 0.06, // rationed accent, as in the design system
        w: Math.random() < 0.22 ? 1.3 : 0.7,
      };
    }

    /** One complete field, drawn immediately — this is the artwork. */
    function paintStatic(streams: number) {
      for (let n = 0; n < streams; n++) {
        const p = make(true);
        // Start off-canvas-left sometimes so streams enter from the edge.
        if (n % 3 === 0) p.x = -Math.random() * 120;
        let x = p.x;
        let y = p.y;
        for (let s = 0; s < 420; s++) {
          const [vx, vy] = vecAt(angleAt(x, y));
          const nx = x + vx * STEP;
          const ny = y + vy * STEP;
          // Taper the ends so streams fade in and out instead of stopping dead.
          const t = s / 420;
          const taper = Math.min(1, t * 6) * Math.min(1, (1 - t) * 4);
          ctx.beginPath();
          ctx.moveTo(x, y);
          ctx.lineTo(nx, ny);
          ctx.lineWidth = p.w;
          ctx.strokeStyle = p.signal
            ? `rgba(255,77,0,${0.4 * taper})`
            : `rgba(150,161,171,${0.22 * taper})`;
          ctx.stroke();
          x = nx;
          y = ny;
          if (x > W + 60 || y < -60 || y > H + 60) break;
        }
      }
    }

    function resize() {
      const rect = canvas!.getBoundingClientRect();
      W = Math.max(1, rect.width);
      H = Math.max(1, rect.height);
      canvas!.width = Math.floor(W * DPR);
      canvas!.height = Math.floor(H * DPR);
      ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
      ctx.clearRect(0, 0, W, H);
      paintStatic(window.innerWidth < 768 ? 70 : 150);
      particles = Array.from({ length: COUNT() }, () => make(true));
    }

    function frame() {
      // Trail decay: erase the ground slightly instead of clearing outright,
      // so the static field slowly gives way to the live one.
      ctx.globalCompositeOperation = 'destination-out';
      ctx.fillStyle = 'rgba(0,0,0,0.012)';
      ctx.fillRect(0, 0, W, H);
      ctx.globalCompositeOperation = 'source-over';

      for (let i = 0; i < particles.length; i++) {
        const p = particles[i];
        const [vx, vy] = vecAt(angleAt(p.x, p.y));
        const nx = p.x + vx * 1.4;
        const ny = p.y + vy * 1.4;
        const a = Math.min(1, p.life / 45) * Math.min(1, (p.max - p.life) / 80);
        ctx.beginPath();
        ctx.moveTo(p.x, p.y);
        ctx.lineTo(nx, ny);
        ctx.lineWidth = p.w;
        ctx.strokeStyle = p.signal ? `rgba(255,77,0,${a * 0.5})` : `rgba(150,161,171,${a * 0.3})`;
        ctx.stroke();
        p.x = nx;
        p.y = ny;
        p.life++;
        if (p.life > p.max || p.x > W + 50 || p.y < -50 || p.y > H + 50) particles[i] = make(false);
      }
      raf = requestAnimationFrame(frame);
    }

    function start() {
      if (running || reduced) return;
      running = true;
      raf = requestAnimationFrame(frame);
    }
    function stop() {
      running = false;
      cancelAnimationFrame(raf);
    }

    resize();
    start();

    // Webfonts change the hero's height; re-measure and repaint once settled.
    window.addEventListener('load', () => {
      stop();
      resize();
      start();
    });

    let resizeTimer = 0;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        stop();
        resize();
        start();
      }, 150);
    });

    // Pause when off-screen or hidden — never the gate that decides whether
    // the field exists, only whether it keeps moving.
    new IntersectionObserver((entries) => (entries.some((e) => e.isIntersecting) ? start() : stop()), {
      threshold: 0,
    }).observe(canvas);
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
  }
</script>
