---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource/fragment-mono';
import '../styles/global.css';
import { SITE } from '../config/site';
import { type Lang, useTranslations, altPath } from '../i18n/ui';
import Analytics from '../components/Analytics.astro';

interface Props {
  lang: Lang;
  /** Current path, used for hreflang alternates. */
  path: string;
  title?: string;
  description?: string;
  /** False for pages that exist in one language only (legal pages). */
  hasAlternate?: boolean;
  /** True for pages that must stay out of the index (404). Also drops the canonical. */
  noindex?: boolean;
}

const { lang, path, title, description, hasAlternate = true, noindex = false } = Astro.props;
const t = useTranslations(lang);
const metaTitle = title ?? t('meta.title');
const metaDescription = description ?? t('meta.description');
const alternate = altPath(lang, path);
const canonical = new URL(path, SITE.url).href;
const alternateUrl = new URL(alternate, SITE.url).href;

/**
 * Structured data. Only verifiable facts — no rating or founding claims we
 * cannot back up; Google penalises invented markup.
 *
 * Address and telephone are now present: the Impressum was written (D-036) and
 * is the source, exactly as this comment previously reserved. Both come from
 * SITE, so the markup cannot drift from the legal page. Still absent on
 * purpose: `vatID` — the Impressum declines to state one.
 */
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${SITE.url}/#organization`,
      name: SITE.name,
      url: SITE.url,
      logo: new URL('/favicon.svg', SITE.url).href,
      image: new URL('/og.png', SITE.url).href,
      description: t('meta.description'),
      email: SITE.email,
      telephone: SITE.phoneE164,
      address: {
        '@type': 'PostalAddress',
        streetAddress: SITE.street,
        postalCode: SITE.zip,
        addressLocality: SITE.city,
        addressRegion: SITE.region,
        addressCountry: SITE.countryCode,
      },
      areaServed: { '@type': 'Country', name: 'Germany' },
      knowsLanguage: ['de', 'en'],
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE.url}/#website`,
      url: SITE.url,
      name: SITE.name,
      inLanguage: lang === 'de' ? 'de-DE' : 'en',
      publisher: { '@id': `${SITE.url}/#organization` },
    },
    {
      '@type': 'ProfessionalService',
      '@id': `${SITE.url}/#service`,
      name: SITE.name,
      url: SITE.url,
      parentOrganization: { '@id': `${SITE.url}/#organization` },
      areaServed: { '@type': 'Country', name: 'Germany' },
      serviceType: [
        t('services.1.title'),
        t('services.2.title'),
        t('services.3.title'),
        t('services.4.title'),
      ],
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: t('services.kicker'),
        itemListElement: [1, 2, 3, 4].map((i) => ({
          '@type': 'Offer',
          itemOffered: {
            '@type': 'Service',
            name: t(`services.${i}.title` as Parameters<typeof t>[0]),
            description: t(`services.${i}.note` as Parameters<typeof t>[0]),
          },
        })),
      },
    },
  ],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{metaTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {/* A 404 is served under every wrong URL — a canonical there would point
        search engines at an error page as though it were the real content. */}
    {!noindex && <link rel="canonical" href={canonical} />}
    {
      hasAlternate && (
        <>
          <link rel="alternate" hreflang={lang === 'de' ? 'en' : 'de'} href={alternateUrl} />
          <link rel="alternate" hreflang={lang} href={canonical} />
          <link rel="alternate" hreflang="x-default" href={new URL(lang === 'de' ? path : alternate, SITE.url).href} />
        </>
      )
    }
    <meta name="generator" content={Astro.generator} />
    <meta property="og:title" content={metaTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:type" content="website" />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={new URL('/og.png', SITE.url).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={metaTitle} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={lang === 'de' ? 'de_DE' : 'en_GB'} />
    {hasAlternate && <meta property="og:locale:alternate" content={lang === 'de' ? 'en_GB' : 'de_DE'} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={metaTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={new URL('/og.png', SITE.url).href} />
    <meta
      name="robots"
      content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1'}
    />
    <meta name="theme-color" content="#14171A" />
    {/* The 404 answers under every wrong URL. Shipping the ProfessionalService
        + OfferCatalog graph there would publish our offer page at addresses
        that do not exist — so structured data follows the same gate as the
        canonical, not just the robots directive. */}
    {!noindex && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} is:inline />}
    <Analytics />
  </head>
  <body>
    <a
      href="#main"
      class="type-annot absolute left-4 top-4 z-50 -translate-y-24 bg-signal px-3 py-2 text-graphite transition-transform focus:translate-y-0"
      >{t('a11y.skip')}</a
    >
    <slot />
  </body>
</html>
