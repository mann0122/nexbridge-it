# Repo-root ignores. website/ carries its own .gitignore for build output.
# .claude/ is versioned deliberately — the agent system is part of the product.

# dependencies
node_modules/

# secrets — never commit, use a manager
.env
.env.*
!.env.example

# tool caches
.impeccable/
.wrangler/

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# editors
.idea/
*.swp
*~
